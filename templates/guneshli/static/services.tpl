<style>
.services .services-row {
    display: flex;
    flex-wrap: wrap;
}

.services .service-col {
    display: flex;
    margin-bottom: 30px;
}

.services .single-service {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.services .service-head {
    height: 230px;
    overflow: hidden;
    position: relative;
}

.services .service-head img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.services .service-content {
    flex: 1;
    min-height: 95px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px 15px;
}

.services .service-content h4 {
    margin: 0;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.services .service-content h4 a {
    display: inline-block;
}
</style>

