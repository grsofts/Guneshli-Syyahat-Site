<div class="col-lg-4 col-md-6 col-12">
<div class="single-news ">

<div class="news-head overlay">
<img src="{image-1}" alt="{title}">
<ul class="news-meta">
<li class="date"><i class="fa fa-calendar"></i>{date=d-M-Y}</li>
<li class="view"><i class="fa fa-comments"></i>{comments-num}</li>
</ul>
</div>

<div class="news-body" style="padding:10px 15px">
<div class="news-content">
<h3 class="news-title" style="margin:0 0"><a href="{full-link}" style="font-size:14px">{title limit="60"}</a></h3>
</div></div>

</div></div>